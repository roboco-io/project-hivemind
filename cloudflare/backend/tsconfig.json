{
  "compilerOptions": {
    "target": "ES2023", "module": "NodeNext", "moduleResolution": "NodeNext",
    "strict": true, "noEmit": true, "allowImportingTsExtensions": true, "resolveJsonModule": true,
    "erasableSyntaxOnly": true, "skipLibCheck": true, "types": ["node"],
    "lib": ["ES2023", "DOM"], "noUncheckedIndexedAccess": true
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "scripts/**/*.ts", "worker-env.d.ts"]
}
