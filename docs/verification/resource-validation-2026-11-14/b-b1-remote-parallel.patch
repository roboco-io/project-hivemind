+const DECIMAL_INTEGER = /^[0-9]+$/;
+
+function parseIntegerParam(
+  raw: unknown,
+  field: string,
+  defaultValue: number,
+  min: number,
+  max: number,
+): number {
+  if (raw === undefined) {
+    return defaultValue;
+  }
+  if (typeof raw !== 'string' || !DECIMAL_INTEGER.test(raw)) {
+    throw validationError({ [field]: ['is invalid'] });
+  }
+  const value = Number(raw);
+  if (!Number.isSafeInteger(value) || value < min || value > max) {
+    throw validationError({ [field]: ['is invalid'] });
+  }
+  return value;
+}
+
+function parseSort(raw: unknown): 'newest' | 'oldest' {
+  if (raw === undefined) {
+    return 'newest';
+  }
+  if (raw === 'newest' || raw === 'oldest') {
+    return raw;
+  }
+  throw validationError({ sort: ['is invalid'] });
+}
