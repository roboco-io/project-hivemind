+const DEFAULT_LIMIT = 20;
+const MAX_LIMIT = 100;
+const DECIMAL_INTEGER = /^\d+$/;
+
+type CommentSort = 'newest' | 'oldest';
+
+interface CommentListQuery {
+  limit: number;
+  offset: number;
+  sort: CommentSort;
+}
+
 function isRecord(value: unknown): value is Record<string, unknown> {
   return typeof value === 'object' && value !== null && !Array.isArray(value);
 }
 
+function parseDecimalParam(
+  raw: unknown,
+  name: string,
+  fallback: number,
+  min: number,
+  max: number,
+): number {
+  if (raw === undefined) {
+    return fallback;
+  }
+  if (typeof raw !== 'string' || !DECIMAL_INTEGER.test(raw)) {
+    throw validationError({ [name]: ['must be a decimal integer'] });
+  }
+  const value = Number(raw);
+  if (!Number.isSafeInteger(value) || value < min || value > max) {
+    throw validationError({ [name]: ['is out of range'] });
+  }
+  return value;
+}
+
+function parseCommentListQuery(query: unknown): CommentListQuery {
+  const params = isRecord(query) ? query : {};
+
+  const limit = parseDecimalParam(params.limit, 'limit', DEFAULT_LIMIT, 1, MAX_LIMIT);
