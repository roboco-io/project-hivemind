{
  "name": "project-hivemind",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/roboco-io/project-hivemind.git"
  },
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "start": "node --env-file-if-exists=.env dist/apps/control-plane/src/main.js",
    "worker": "node --env-file-if-exists=.env dist/apps/worker/src/main.js",
    "worker:once": "npm run worker -- --once",
    "check": "npm run typecheck && npm test",
    "mcp": "node dist/apps/mcp-server/src/main.js",
    "mcp:configure": "node scripts/configure-hivemind-mcp.ts",
    "mcp:configure:claude": "node scripts/configure-hivemind-claude.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "fastify": "^5.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
