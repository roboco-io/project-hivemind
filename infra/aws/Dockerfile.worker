FROM node:24-slim AS build
WORKDIR /app
COPY package.json package-lock.json tsconfig.json ./
RUN npm ci --ignore-scripts
COPY packages ./packages
COPY apps ./apps
COPY cloudflare/backend/src ./cloudflare/backend/src
RUN npm run build

FROM node:24-slim
WORKDIR /app
# Isolated AI Worker image: Git + ripgrep + Node 24 + official Codex & Claude Code CLIs (Gemini excluded),
# plus Python 3.12 and the AWS CLI.
# Never includes operator tokens, GitHub push tokens, or control-plane SQLite files.
RUN apt-get update && apt-get install -y --no-install-recommends git ca-certificates ripgrep curl && rm -rf /var/lib/apt/lists/*
RUN npm install --global @openai/codex@0.171.0 @anthropic-ai/claude-code@2.1.331 && npm cache clean --force
# Python 3.12 for Model Factory data and evaluation scripts (issue #20), and the AWS CLI for scoped
# credentials the Control Plane issues. Debian bookworm ships 3.11, so uv installs a pinned 3.12.
COPY --from=ghcr.io/astral-sh/uv:0.9.30 /uv /uvx /usr/local/bin/
ENV UV_PYTHON_INSTALL_DIR=/opt/uv-python
RUN uv python install 3.12 \
 && PY="$(uv python find 3.12)" \
 && ln -sf "$PY" /usr/local/bin/python3.12 && ln -sf "$PY" /usr/local/bin/python3 && ln -sf "$PY" /usr/local/bin/python \
 && uv venv /opt/awscli --python 3.12 && uv pip install --python /opt/awscli/bin/python awscli \
 && ln -sf /opt/awscli/bin/aws /usr/local/bin/aws \
 && chmod -R a+rX /opt/uv-python /opt/awscli
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts
COPY --from=build /app/dist ./dist
RUN mkdir -p /app/.work /tmp/hivemind && chown -R node:node /app /tmp/hivemind
USER node
ENV PATH="/app/node_modules/.bin:${PATH}"
ENV HIVEMIND_WORK_ROOT="/app/.work"
STOPSIGNAL SIGTERM
CMD ["node", "dist/apps/worker/src/aws-worker-main.js"]
