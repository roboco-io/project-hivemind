HIVEMIND_HOST=127.0.0.1
HIVEMIND_PORT=4310
HIVEMIND_DB=data/hivemind.sqlite
HIVEMIND_OPERATOR_TOKEN=local-development-only
HIVEMIND_WORKER_TOKEN=local-worker-only
HIVEMIND_API_URL=http://127.0.0.1:4310
HIVEMIND_WORKER_ID=worker-local-1

# Real local Codex worker (same repository and test command on server and worker).
# Requires Git, installed Codex CLI and an existing `codex login`.
# HIVEMIND_PROVIDER=codex
# HIVEMIND_REPO_PATH=/absolute/path/to/trusted/repository
# HIVEMIND_WORKTREE_ROOT=data/worktrees
# HIVEMIND_TEST_COMMAND=["npm","run","check"]
# Optional dependency setup; lifecycle scripts remain disabled.
# HIVEMIND_SETUP_COMMAND=["npm","ci","--ignore-scripts","--no-audit","--no-fund"]
# HIVEMIND_CODEX_BIN=codex
# HIVEMIND_CODEX_MODEL=your-model
# HIVEMIND_CODEX_TIMEOUT_MS=600000
# HIVEMIND_TEST_TIMEOUT_MS=120000
