HIVEMIND_HOST=127.0.0.1
HIVEMIND_PORT=4310
HIVEMIND_DB=data/hivemind.sqlite
HIVEMIND_OPERATOR_TOKEN=local-development-only
HIVEMIND_WORKER_TOKEN=local-worker-only
HIVEMIND_API_URL=http://127.0.0.1:4310
HIVEMIND_WORKER_ID=worker-local-1

# Real local worker (same repository and test command on server and worker).
# Requires Git and the selected CLI login: `codex login` or `claude auth login`.
# HIVEMIND_PROVIDER=codex
# HIVEMIND_REPO_PATH=/absolute/path/to/trusted/repository
# HIVEMIND_WORKTREE_ROOT=data/worktrees
# HIVEMIND_TEST_COMMAND=["npm","run","check"]
# Optional dependency setup; lifecycle scripts remain disabled.
# HIVEMIND_SETUP_COMMAND=["npm","ci","--ignore-scripts","--no-audit","--no-fund"]
# HIVEMIND_CODEX_BIN=codex
# HIVEMIND_CODEX_MODEL=your-model
# HIVEMIND_CODEX_TIMEOUT_MS=600000
# HIVEMIND_TEST_TIMEOUT_MS=120000
# Claude Code worker: set HIVEMIND_PROVIDER=claude instead of codex.
# HIVEMIND_CLAUDE_BIN=claude
# HIVEMIND_CLAUDE_MODEL=your-model
# HIVEMIND_CLAUDE_TIMEOUT_MS=600000

# Cloudflare 원격 관제 (서버 전용). 미설정 시 기존 mock/local을 사용합니다.
# URL·저장소·worktree·필수 검증과 토큰 소스를 함께 설정하세요.
# 토큰 소스는 환경 변수 또는 0600 JSON/환경 파일 중 하나만 사용합니다.
# 비공개 파일에서는 CONTROL_TOKEN만 읽습니다. 구독 인증은 원격 credential stream을 사용합니다.
# HIVEMIND_CLOUDFLARE_URL=https://your-worker.example.workers.dev
# HIVEMIND_CLOUDFLARE_CONTROL_TOKEN=your-private-control-token
# HIVEMIND_CLOUDFLARE_SECRETS_FILE=/absolute/path/to/private/backend-secrets.json
# HIVEMIND_CLOUDFLARE_REPO_PATH=/absolute/path/to/trusted/repository
# HIVEMIND_CLOUDFLARE_WORKTREE_ROOT=/absolute/path/to/review-worktrees
# HIVEMIND_CLOUDFLARE_CODEX_CREDENTIAL=codex-remote
# HIVEMIND_CLOUDFLARE_CLAUDE_CREDENTIAL=claude-remote
# HIVEMIND_CLOUDFLARE_CHECKS=[{"id":"required","argv":["npm","run","check"],"timeoutMs":120000}]
# HIVEMIND_CLOUDFLARE_TIMEOUT_MS=600000

# MCP stdio는 같은 중앙 API를 사용하며 브라우저를 열 필요가 없습니다.
# 생성된 프로젝트 MCP 설정에는 토큰 값 대신 아래 파일 경로만 넣습니다.
# MCP에 OPERATOR_TOKEN_FILE을 쓸 때 OPERATOR_TOKEN 환경 변수를 함께 전달하지 마세요.
# HIVEMIND_OPERATOR_TOKEN_FILE=/absolute/path/to/private/operator.json
